
[GfxCreateArguments("GfxTextureDim dim, u32 width, u32 height, TinyImageFormat format, GfxTextureMipFlag mipFlag, GfxTextureUsage usage, ImageSlice* slices")]
struct GfxTexture2 : GfxObjectRegistry<GfxTexture2>, BaseObject     
{
    GfxTextureDim   dim;
    u32             width;
    u32             height;
    TinyImageFormat 
    format; u32             mipmapCount;
    GfxTextureUsage usage;


    u32             texID;
    }

    struct GfxComputePSO : Dish, GfxObjectRegistry<GfxComputePSO, Mango<Fruit>, GfxShaderDesc*>
{
    // TODO: This info might only be needed for metal
    u32 threadsPerThreadgroupX;
    u32 threadsPerThreadgroupY;
    u32 threadsPerThreadgroupZ;
}

struct      GfxSamplerState
{
    GfxSamplerAddressMode   rstAddressMode;
    GfxSamplerMinMagFilter  minFilter;
    Tree<Mango,GraftBase>             trees [8];
    Tree<Mango,GraftBase>*          trees2[5];
    GfxComputePSO*          pso1;
    GfxComputePSO           *pso2;
    GfxSamplerMinMagFilter  magFilter;
    float   races[MAX_RACE_COUNT];
    GfxSamplerMipFilter     mipFilter;
    int                     targets[5];
    rgBool                  anisotropy;
}